# Example configuration for multi-class classification
# This is a future configuration format - currently only 'spam' and 'ham' classes are supported

# Basic two-class configuration (currently supported)
classifier "bayes" {
  tokenizer {
    name = "osb";
  }
  cache {
  }
  new_schema = true;
  store_tokens = false;
  signatures = false;
  min_tokens = 11;
  backend = "redis";
  min_learns = 200;

  statfile {
    symbol = "BAYES_HAM";
    spam = false;  # Traditional boolean format
  }
  statfile {
    symbol = "BAYES_SPAM";
    spam = true;   # Traditional boolean format
  }

  learn_condition = 'return require("lua_bayes_learn").can_learn';
}

# Future multi-class configuration example (not yet fully supported)
# This shows how the configuration might look when full multi-class support is implemented
# 
# classifier "bayes_multiclass" {
#   tokenizer {
